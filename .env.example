# ==============================================================================
# Ọjà Ọnà — Environment Variables Blueprint
# Copy this file to .env.local for local development. Never commit .env or secrets.
# ==============================================================================

# Supabase (Database, Auth & Storage)
# Note: Next.js requires the NEXT_PUBLIC_ prefix for any key accessed in client components ('use client')
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only keys (Supports both modern and legacy naming)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Paystack (Naira Escrow & Transfers API)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...

# Replicate (CLIP ViT-L/14 Vision Model for 768-dim Visual Search)
REPLICATE_API_TOKEN=r8_...

# Privy (Invisible Embedded Non-Custodial Wallets)
NEXT_PUBLIC_PRIVY_APP_ID=cl...
PRIVY_APP_SECRET=...

# Base L2 (ERC-721 Digital Certificates)
BASE_RPC_URL=https://mainnet.base.org
CERTIFICATE_CONTRACT_ADDRESS=0x...
